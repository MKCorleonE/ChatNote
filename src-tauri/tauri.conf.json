{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatNote",
  "version": "0.14.0",
  "identifier": "app.chatnote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "decorations": false,
        "title": "ChatNote",
        "width": 1280,
        "height": 860,
        "minWidth": 390,
        "minHeight": 600,
        "backgroundColor": "#17191c",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "A quieter space for deeper questions",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true,
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../docs/THIRD_PARTY_SOURCE.md": "THIRD_PARTY_SOURCE.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4MjlDMkUxOEFCNjc5NzMKUldSemViYUs0Y0lwQ0xxSitVSEZkdWY0R1V1emxvcVBsRGZnVmhMcCtzRVZzTjZqVVQ5NldvdTYK",
      "endpoints": [
        "https://mkcorleone.github.io/chatnote-site/updates/stable.json",
        "https://github.com/MKCorleonE/ChatNote/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
